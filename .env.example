# Copy to .env and fill in values. Generated by auditing every process.env.*
# reference in app/, lib/, actions/, and components/ — see the audit notes in
# the PR/commit that introduced this file for the full breakdown.

# ==================================================
# Application
# ==================================================
NODE_ENV=production

# Base URL used to build deep links in outbound notifications (optional;
# feature degrades gracefully without it). lib/notifySitePhotoRequest.ts
APP_BASE_URL=

# ==================================================
# Database (Neon / Postgres)
# ==================================================
DATABASE_URL=
DIRECT_URL=

# ==================================================
# Authentication (NextAuth — this app does not use Better Auth)
# ==================================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ==================================================
# Cloudinary (image uploads — lib/cloudinary.ts)
# ==================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================================================
# Mapbox (client-side site map — must be NEXT_PUBLIC_ to reach the browser)
# ==================================================
NEXT_PUBLIC_MAPBOX_TOKEN=

# ==================================================
# WhatsApp Cloud API (optional — outbound notifications only, lib/whatsapp.ts)
# ==================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ==================================================
# OpenAI (optional — paint TDS AI parsing, lib/paint-tds/parsePaintTdsWithAi.ts)
# Feature no-ops with a warning if OPENAI_API_KEY is unset.
# ==================================================
OPENAI_API_KEY=
OPENAI_TDS_MODEL=gpt-4.1-mini

# ==================================================
# Cron (optional — protects /api/cron/cleanup; endpoint rejects all requests
# if unset, so this is safe to leave blank until you wire up a scheduler)
# ==================================================
CRON_SECRET=
