generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// *
///  * AUTH / PEOPLE
model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  role                 UserRole
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  password             String
  phone                String?
  accounts             Account[]
  auditEvents          AuditEvent[]
  employees            Employee[]
  employee             Employee?             @relation("EmployeeUser")
  foreman              Foreman?
  photoVerifications   PhotoVerification[]
  pushTokens           PushToken[]
  sessions             Session[]
  siteDayPhotos        SiteDayPhoto[]
  siteDayPhotoRequests SiteDayPhotoRequest[]
  supervisor           Supervisor?
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// *
///  * WORKER / EMPLOYEE
///  * Added:
///  * - faceImageUrl + metadata so admin can visually verify later.
///  * - faceEmbedding optional placeholder if you later do ML matching.
model Employee {
  id              String             @id @default(cuid())
  firstName       String
  lastName        String
  qrCodeValue     String             @unique
  defaultDayRate  Decimal?           @db.Decimal(12, 2)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdByUserId String?
  faceImageUrl    String?
  userId          String?            @unique
  idNumber        String?
  attendance      AttendanceScan[]
  createdByUser   User?              @relation(fields: [createdByUserId], references: [id])
  user            User?              @relation("EmployeeUser", fields: [userId], references: [id])
  assistantLinks  ForemanAssistant[] @relation("AssistantToForemen")
  foremanLinks    ForemanEmployee[]
  photoDetections PhotoDetection[]
}

model Supervisor {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  foremanLinks       SupervisorForeman[]
  siteAssignments    SupervisorSiteAssignment[]
  approvedTimesheets Timesheet[]                @relation("SupervisorApprovals")
  dayAcceptances     TimesheetDayAcceptance[]   @relation("DayAcceptances")
}

model Foreman {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  defaultDayRate  Decimal?                @db.Decimal(12, 2)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistants      ForemanAssistant[]
  employeeLinks   ForemanEmployee[]
  siteAssignments ForemanSiteAssignment[]
  siteDays        SiteDay[]
  supervisorLinks SupervisorForeman[]
  timesheets      Timesheet[]
}

model ForemanAssistant {
  foremanId  String
  employeeId String
  startsOn   DateTime  @default(now())
  endsOn     DateTime?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation("AssistantToForemen", fields: [employeeId], references: [id], onDelete: Cascade)
  foreman    Foreman   @relation(fields: [foremanId], references: [id], onDelete: Cascade)

  @@id([foremanId, employeeId])
  @@index([employeeId])
}

model ForemanEmployee {
  foremanId  String
  employeeId String
  reason     String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  foreman    Foreman  @relation(fields: [foremanId], references: [id], onDelete: Cascade)

  @@id([foremanId, employeeId])
  @@index([employeeId])
}

model SupervisorForeman {
  supervisorId String
  foremanId    String
  startsOn     DateTime   @default(now())
  endsOn       DateTime?
  createdAt    DateTime   @default(now())
  foreman      Foreman    @relation(fields: [foremanId], references: [id], onDelete: Cascade)
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@id([supervisorId, foremanId, startsOn])
  @@index([supervisorId])
  @@index([foremanId])
}

/// *
///  * SITES + ASSIGNMENTS
model Site {
  id                    String                     @id @default(cuid())
  name                  String
  code                  String?                    @unique
  location              String?
  isActive              Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  address               String?
  latitude              Float?
  longitude             Float?
  attendanceScans       AttendanceScan[]
  foremanAssignments    ForemanSiteAssignment[]
  siteDays              SiteDay[]
  supervisorAssignments SupervisorSiteAssignment[]
  timesheets            Timesheet[]
}

model SupervisorSiteAssignment {
  id           String     @id @default(cuid())
  supervisorId String
  siteId       String
  startsOn     DateTime   @default(now())
  endsOn       DateTime?
  createdAt    DateTime   @default(now())
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([supervisorId, siteId, startsOn])
  @@index([supervisorId])
  @@index([siteId])
}

model ForemanSiteAssignment {
  id        String    @id @default(cuid())
  foremanId String
  siteId    String
  startsOn  DateTime  @default(now())
  endsOn    DateTime?
  createdAt DateTime  @default(now())
  foreman   Foreman   @relation(fields: [foremanId], references: [id], onDelete: Cascade)
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([foremanId, siteId, startsOn])
  @@index([foremanId])
  @@index([siteId])
}

/// *
///  * DAILY SHEET (per site per day)
model SiteDay {
  id            String                @id @default(cuid())
  siteId        String
  foremanId     String
  workDate      DateTime
  isLocked      Boolean               @default(false)
  lockedAt      DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  readyToSubmit Boolean               @default(false)
  scans         AttendanceScan[]
  foreman       Foreman               @relation(fields: [foremanId], references: [id])
  site          Site                  @relation(fields: [siteId], references: [id])
  photos        SiteDayPhoto[]
  photoRequests SiteDayPhotoRequest[]

  @@unique([siteId, foremanId, workDate])
  @@index([foremanId, workDate])
  @@index([siteId, workDate])
}

/// *
///  * SCANS
model AttendanceScan {
  id               String       @id @default(cuid())
  siteDayId        String
  employeeId       String
  workDate         DateTime
  siteId           String
  scannedAt        DateTime     @default(now())
  dayRateAtScan    Decimal      @db.Decimal(12, 2)
  qrPayload        String?
  createdAt        DateTime     @default(now())
  addedByForemanId String?
  manualReason     String?
  overtimeType     OvertimeType @default(NONE)
  scanType         ScanType     @default(REGULAR)
  latitude         Float?
  longitude        Float?
  address          String?
  employee         Employee     @relation(fields: [employeeId], references: [id])
  siteDay          SiteDay      @relation(fields: [siteDayId], references: [id], onDelete: Cascade)
  site             Site         @relation(fields: [siteId], references: [id])

  @@unique([employeeId, workDate])
  @@unique([siteDayId, employeeId])
  @@index([siteId, workDate])
  @@index([siteDayId])
  @@index([scannedAt])
  @@index([scanType])
}

/// *
///  * RANDOM GROUP PHOTO REQUESTS + SUBMISSIONS
///  * Request: system/admin asks foreman to upload a group photo for a day.
///  * Photo: foreman uploads one or more photos.
model SiteDayPhotoRequest {
  id                String             @id @default(cuid())
  siteDayId         String
  status            PhotoRequestStatus @default(REQUESTED)
  requestedAt       DateTime           @default(now())
  dueAt             DateTime?
  requestedByUserId String?
  note              String?
  siteDayPhotos     SiteDayPhoto[]
  requestedByUser   User?              @relation(fields: [requestedByUserId], references: [id])
  siteDay           SiteDay            @relation(fields: [siteDayId], references: [id], onDelete: Cascade)

  @@index([siteDayId, status])
  @@index([requestedAt])
}

model SiteDayPhoto {
  id                 String               @id @default(cuid())
  siteDayId          String
  imageUrl           String
  uploadedAt         DateTime             @default(now())
  uploadedByUserId   String?
  requestId          String?
  cloudinaryPublicId String?
  latitude           Float?
  longitude          Float?
  address            String?
  detections         PhotoDetection[]
  verification       PhotoVerification?
  request            SiteDayPhotoRequest? @relation(fields: [requestId], references: [id])
  siteDay            SiteDay              @relation(fields: [siteDayId], references: [id], onDelete: Cascade)
  uploadedByUser     User?                @relation(fields: [uploadedByUserId], references: [id])

  @@index([siteDayId, uploadedAt])
  @@index([requestId])
}

/// *
///  * OPTIONAL: store verification outcome + who checked it.
///  * This supports manual checks now, and ML-assisted checks later.
model PhotoVerification {
  id                      String                  @id @default(cuid())
  photoId                 String                  @unique
  status                  PhotoVerificationStatus @default(PENDING)
  verifiedByUserId        String?
  verifiedAt              DateTime?
  notes                   String?
  bookedCount             Int?
  detectedCount           Int?
  missingCount            Int?
  suspectedImpersonations Int?
  photo                   SiteDayPhoto            @relation(fields: [photoId], references: [id], onDelete: Cascade)
  verifiedByUser          User?                   @relation(fields: [verifiedByUserId], references: [id])

  @@index([status])
  @@index([verifiedAt])
}

/// *
///  * OPTIONAL: who appears in a group photo (manual tags now, ML later)
///  * If later you run face detection/matching, you can write rows here.
///  * For manual verification, admin can tag "this is employee X" per photo.
model PhotoDetection {
  id         String       @id @default(cuid())
  photoId    String
  employeeId String?
  data       Json?
  isManual   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  employee   Employee?    @relation(fields: [employeeId], references: [id])
  photo      SiteDayPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([employeeId])
}

/// *
///  * TIMESHEETS (fortnight)
model TimesheetPeriod {
  id         String      @id @default(cuid())
  startDate  DateTime
  endDate    DateTime
  label      String?
  createdAt  DateTime    @default(now())
  timesheets Timesheet[]

  @@unique([startDate, endDate])
  @@index([startDate])
  @@index([endDate])
}

model Timesheet {
  id                     String                   @id @default(cuid())
  periodId               String
  foremanId              String
  status                 TimesheetStatus          @default(SUBMITTED)
  submittedAt            DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  paidAt                 DateTime?
  approvedBySupervisorId String?
  rejectionReason        String?
  totalWorkerWages       Decimal?                 @db.Decimal(14, 2)
  totalWorkerDays        Int?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  siteId                 String?
  approvedBySupervisor   Supervisor?              @relation("SupervisorApprovals", fields: [approvedBySupervisorId], references: [id])
  foreman                Foreman                  @relation(fields: [foremanId], references: [id])
  period                 TimesheetPeriod          @relation(fields: [periodId], references: [id])
  site                   Site?                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  dayAcceptances         TimesheetDayAcceptance[]

  @@unique([periodId, foremanId, siteId])
  @@index([status])
  @@index([foremanId, periodId])
  @@index([approvedBySupervisorId])
  @@index([siteId])
}

model TimesheetDayAcceptance {
  id                     String              @id @default(cuid())
  timesheetId            String
  workDate               DateTime
  status                 DayAcceptanceStatus @default(PENDING)
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  acceptedBySupervisorId String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  acceptedBySupervisor   Supervisor?         @relation("DayAcceptances", fields: [acceptedBySupervisorId], references: [id])
  timesheet              Timesheet           @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, workDate])
  @@index([timesheetId])
  @@index([workDate])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// *
///  * COMPANY SETTINGS
model CompanySettings {
  id                     String   @id @default("singleton")
  defaultEmployeeDayRate Decimal  @default(0) @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// *
///  * AUDIT TRAIL
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([action])
  @@index([entity, entityId])
  @@index([actorUserId])
}

model TimesheetYear {
  year      Int      @id
  anchorSat DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  SUPERVISOR
  FOREMAN
}

enum TimesheetStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  ACCEPTED
}

enum PhotoRequestStatus {
  REQUESTED
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum PhotoVerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
}

enum ScanType {
  REGULAR
  MANUAL
}

enum OvertimeType {
  NONE
  HALF_DAY
  FULL_DAY
}

enum DayAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}
