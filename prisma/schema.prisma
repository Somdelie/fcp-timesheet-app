model ProductCategory {
  id             String  @id @default(cuid())
  name           String
  normalizedName String?

  procurementProducts ProcurementProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([normalizedName])
}

// NEW: supplier type for brand/shop hierarchy
enum SupplierType {
  BRAND
  VENDOR
}

model Supplier {
  id             String  @id @default(cuid())
  name           String
  normalizedName String?
  phone          String?
  email          String?
  address        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: brand/shop hierarchy
  supplierType SupplierType @default(VENDOR)

  parentSupplierId String?
  parentSupplier   Supplier?  @relation("SupplierHierarchy", fields: [parentSupplierId], references: [id], onDelete: SetNull)
  childSuppliers   Supplier[] @relation("SupplierHierarchy")

  // relations
  products               ProcurementProduct[]
  orders                 SiteProductOrder[]
  supplierProductPrices  SupplierProductPrice[]
  finishingScheduleItems SiteFinishingScheduleItem[] @relation("FinishingScheduleItemSupplier")

  @@unique([name])
  @@index([isActive])
  @@index([normalizedName])
  @@index([parentSupplierId])
  @@index([supplierType])
}

// A product in the procurement catalog (paints, cement, etc.)
model ProcurementProduct {
  id           String           @id @default(cuid())
  name         String
  sku          String?
  thumbnailUrl String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Legacy base unit info (sizes now live on SupplierProductPrice)
  uom         ProductUom?
  unitSize    Decimal?    @db.Decimal(12, 3)
  description String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional default supplier
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Prices can vary by supplier (and over time)
  supplierPrices SupplierProductPrice[]

  // order items using this product
  orderItems SiteProductOrderItem[]

  // Sites where this product is expected to be used
  siteMaterials SiteMaterial[]

  finishingScheduleItems SiteFinishingScheduleItem[]

  normalizedName String?

  coverageProfiles ProcurementProductCoverage[]
  paintPlans       SitePaintPlan[]

  @@unique([sku])
  @@index([isActive])
  @@index([categoryId])
  @@index([name])
  @@index([normalizedName])
}

// Price list per supplier per product (optionally time-bounded)
model SupplierProductPrice {
  id String @id @default(cuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Size variant this price applies to (e.g. 5L, 20L, 40KG)
  uom      ProductUom?
  unitSize Decimal?    @db.Decimal(12, 3)

  // current/active price for that supplier/product
  price Decimal @db.Decimal(12, 2)

  // optional effective window
  startsOn DateTime  @default(now())
  endsOn   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, productId])
  @@index([productId, isActive])
  @@index([supplierId, isActive])
}

// Procurement order against a SITE (not a foreman order)
model SiteProductOrder {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // optional: who created the order (admin user)
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  reference String? // e.g. PO number, ticket number
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SiteProductOrderItem[]

  // Optional cached totals (safe because optional)
  totalCost Decimal? @db.Decimal(14, 2)

  @@index([siteId, createdAt])
  @@index([supplierId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([reference])
}

// Items inside the site order
model SiteProductOrderItem {
  id String @id @default(cuid())

  orderId String
  order   SiteProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  // quantity of the product (e.g. 5x 20L)
  quantity Int

  // ✅ IMPORTANT: snapshot the unit price used at order time (keeps history stable)
  unitPriceAtOrder Decimal @default(0) @db.Decimal(12, 2)

  // Optional: store what UOM/size was ordered (if product changes later)
  uomAtOrder      ProductUom?
  unitSizeAtOrder Decimal?    @db.Decimal(12, 3)

  note String?

  costCodeId String?
  costCode   SiteCostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([costCodeId])
}

//
// ============================
// FORTNIGHT MEETING REPORT (SNAPSHOT) - NEW
// ============================

model FortnightMeeting {
  id        String   @id @default(cuid())
  startDate DateTime // report range start
  endDate   DateTime // report range end
  meetingOn DateTime // your Thursday meeting date

  // Legacy – kept nullable for old data
  periodId String?

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  generatedAt       DateTime  @default(now())
  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedByUser   User?     @relation("FortnightMeetingFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows   FortnightMeetingRow[]
  totals FortnightMeetingTotals?

  period TimesheetPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@unique([startDate, endDate])
  @@index([meetingOn])
  @@index([finalizedAt])
}

model FortnightMeetingRow {
  id        String @id @default(cuid())
  meetingId String
  siteId    String

  // ===== COSTS (what you implement now) =====
  materialCost Decimal @default(0) @db.Decimal(14, 2)
  wagesCost    Decimal @default(0) @db.Decimal(14, 2)
  overtimeCost Decimal @default(0) @db.Decimal(14, 2)
  projectCost  Decimal @default(0) @db.Decimal(14, 2) // material + wages + overtime

  // ===== REVENUE (keep for later; set 0 now) =====
  revenueClaimed  Decimal @default(0) @db.Decimal(14, 2)
  revenueReceived Decimal @default(0) @db.Decimal(14, 2)

  // ===== PROFIT/LOSS (keep for later; set 0 now) =====
  profitOrLoss Decimal @default(0) @db.Decimal(14, 2)

  // Optional % columns (like your sheet). You can compute later.
  materialPct Decimal? @db.Decimal(8, 2)
  wagesPct    Decimal? @db.Decimal(8, 2)
  profitPct   Decimal? @db.Decimal(8, 2)

  // ===== COMPARISON VS PREVIOUS MEETING (optional snapshot) =====
  prevProjectCost  Decimal? @db.Decimal(14, 2)
  prevWagesCost    Decimal? @db.Decimal(14, 2)
  prevMaterialCost Decimal? @db.Decimal(14, 2)

  // deltas (current vs previous)
  projectCostDeltaPct  Decimal? @db.Decimal(8, 2)
  wagesCostDeltaPct    Decimal? @db.Decimal(8, 2)
  materialCostDeltaPct Decimal? @db.Decimal(8, 2)

  meeting FortnightMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  site    Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([meetingId, siteId])
  @@index([siteId])
}

//
// ============================
// OVERTIME PRICES + ENTRIES
// ============================

model OvertimePrice {
  id    String  @id @default(cuid())
  label String
  rate  Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overtimeEntries OvertimeEntry[]

  @@index([isActive])
}

model OvertimeEntry {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  foremanId String
  foreman   Foreman @relation(fields: [foremanId], references: [id], onDelete: Cascade)

  workDate DateTime

  overtimePriceId String
  overtimePrice   OvertimePrice @relation(fields: [overtimePriceId], references: [id], onDelete: Restrict)

  // Snapshot of the rate at creation time
  rateAtCreation Decimal @db.Decimal(12, 2)

  numberOfEmployees Int
  hoursWorked       Decimal @db.Decimal(6, 2)

  // Computed total = rateAtCreation * numberOfEmployees * hoursWorked
  totalCost Decimal @db.Decimal(14, 2)

  note String?

  costCodeId String?
  costCode   SiteCostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, workDate])
  @@index([foremanId, workDate])
  @@index([overtimePriceId])
  @@index([createdByUserId])
  @@index([workDate])
  @@index([costCodeId])
}

model FortnightMeetingTotals {
  id        String @id @default(cuid())
  meetingId String @unique

  totalMaterialCost Decimal @default(0) @db.Decimal(14, 2)
  totalWagesCost    Decimal @default(0) @db.Decimal(14, 2)
  totalOvertimeCost Decimal @default(0) @db.Decimal(14, 2)
  totalProjectCost  Decimal @default(0) @db.Decimal(14, 2)

  // Revenue totals (0 for now)
  totalRevenueClaimed  Decimal @default(0) @db.Decimal(14, 2)
  totalRevenueReceived Decimal @default(0) @db.Decimal(14, 2)

  // Profit/Loss total (0 for now)
  totalProfitOrLoss Decimal @default(0) @db.Decimal(14, 2)

  meeting FortnightMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

