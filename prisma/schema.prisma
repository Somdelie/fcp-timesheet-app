//
// ============================
// PROCUREMENT / SITE PRODUCT ORDERS (NEW)
// ============================

enum ProductType {
  MATERIAL // paints, plaster, cement, chemicals
  PPE // overalls, hard hats, safety boots, gloves
  PLANT // step ladders, compressors, generators, extension cables, lifelines
  CONSUMABLE // plastics, tapes, rags, adhesives
  OTHER
}

enum PlantStatus {
  AVAILABLE
  DEPLOYED
  RETURNED
  REPAIR
  DAMAGED
  LOST
}

enum PpeOrderStatus {
  PENDING
  APPROVED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

// Units / variants you mentioned
enum ProductUom {
  // Length
  MM
  CM
  M
  M2
  M3

  // Weight
  G
  KG
  TON

  // Volume
  ML
  L

  // Packaging
  UNIT
  PIECE
  PACK
  BOX
  BAG
  BUCKET
  DRUM
  CAN
  BOTTLE
  TUBE
  BAR
  EACH

  // Sheet / Roll / Bulk
  ROLL
  SHEET
  BUNDLE
  PALLET

  // Time-based
  HOUR
  DAY
}

model ProductCategory {
  id             String  @id @default(cuid())
  name           String
  normalizedName String?

  procurementProducts ProcurementProduct[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  materials Material[]

  @@index([normalizedName])
}

// NEW: supplier type for brand/shop hierarchy
enum SupplierType {
  BRAND
  VENDOR
}

model Supplier {
  id             String  @id @default(cuid())
  name           String
  normalizedName String?
  phone          String?
  email          String?
  address        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: brand/shop hierarchy
  supplierType SupplierType @default(VENDOR)

  parentSupplierId String?
  parentSupplier   Supplier?  @relation("SupplierHierarchy", fields: [parentSupplierId], references: [id], onDelete: SetNull)
  childSuppliers   Supplier[] @relation("SupplierHierarchy")

  // relations
  products               ProcurementProduct[]
  orders                 SiteProductOrder[]
  supplierProductPrices  SupplierProductPrice[]
  finishingScheduleItems SiteFinishingScheduleItem[] @relation("FinishingScheduleItemSupplier")
  materials              Material[]
  materialPrices         MaterialPrice[]

  @@unique([name])
  @@index([isActive])
  @@index([normalizedName])
  @@index([parentSupplierId])
  @@index([supplierType])
}

// A product in the procurement catalog (paints, cement, PPE, plant, etc.)
model ProcurementProduct {
  id           String           @id @default(cuid())
  name         String
  sku          String?
  thumbnailUrl String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Product classification
  productType  ProductType @default(MATERIAL)
  isReturnable Boolean     @default(false)

  // Color variants (e.g. for paints: ["White", "Sandstone", "Light Grey"])
  colors String[]

  // Size variants (e.g. for PPE: ["S","M","L","XL"] or plant: ["3m","5m"])
  sizes String[]

  // Inventory count
  stockQty Int @default(0)

  // Legacy base unit info (sizes now live on SupplierProductPrice)
  uom         ProductUom?
  unitSize    Decimal?    @db.Decimal(12, 3)
  description String?

  isActive Boolean @default(true)

  // Deduction settings (PPE only)
  isDeductible    Boolean @default(true)
  deductionSplits Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional default supplier
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Prices can vary by supplier (and over time)
  supplierPrices SupplierProductPrice[]

  // order items using this product
  orderItems SiteProductOrderItem[]

  // Sites where this product is expected to be used
  siteMaterials SiteMaterial[]

  finishingScheduleItems SiteFinishingScheduleItem[]

  normalizedName String?

  coverageProfiles ProcurementProductCoverage[]
  paintPlans       SitePaintPlan[]

  // Plant assignments to sites
  plantAssignments SitePlantAssignment[]

  // PPE order items
  ppeOrderItems ForemanPpeOrderItem[]

  // Plant transfer audit trail
  plantTransfers PlantTransfer[]

  // Per-variant inventory (size × color)
  variantStocks ProductVariantStock[]

  colorVariants ProductColorVariant[]

  @@unique([sku])
  @@index([isActive])
  @@index([categoryId])
  @@index([name])
  @@index([normalizedName])
  @@index([productType])
  @@index([isReturnable])
}

// ============================
// COLOR VARIANTS
// ============================
// Represents a specific color/tint variant of a procurement product.
// Colors are extracted from product descriptions and stored separately.

enum ColorBaseType {
  DEEP
  PASTEL
  WHITE
  CLEAR
  NEUTRAL
}

model ProductColorVariant {
  id        String             @id @default(cuid())
  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  colorName String
  colorCode String?

  baseType ColorBaseType @default(DEEP)

  isTinted Boolean @default(false)

  supplierPrices SupplierProductPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorName, baseType])
  @@index([productId])
  @@index([colorName])
  @@index([baseType])
}

// Per-variant inventory tracking (size × color quantities)
model ProductVariantStock {
  id        String             @id @default(cuid())
  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  qty       Int                @default(0)

  @@unique([productId, size, color])
  @@index([productId])
}

// Price list per supplier per product (optionally time-bounded)
model SupplierProductPrice {
  id String @id @default(cuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Optional: link to a specific color variant of this product
  colorVariantId String?
  colorVariant   ProductColorVariant? @relation(fields: [colorVariantId], references: [id], onDelete: SetNull)

  // Size variant this price applies to (e.g. 5L, 20L, 40KG)
  uom      ProductUom?
  unitSize Decimal?    @db.Decimal(12, 3)

  // current/active price for that supplier/product
  price Decimal @db.Decimal(12, 2)

  // optional effective window
  startsOn DateTime  @default(now())
  endsOn   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, productId])
  @@index([productId, isActive])
  @@index([supplierId, isActive])
}

// Procurement order against a SITE (not a foreman order)
model SiteProductOrder {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // optional: who created the order (admin user)
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // optional: which foreman this order is for (batch orders create one record per foreman)
  foremanId   String?
  foreman     Foreman? @relation("ForemanSiteProductOrders", fields: [foremanId], references: [id], onDelete: SetNull)
  foremanName String? // snapshot of foreman name at order time

  reference String? // e.g. PO number, ticket number
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SiteProductOrderItem[]

  // Optional cached totals (safe because optional)
  totalCost Decimal? @db.Decimal(14, 2)

  @@index([siteId, createdAt])
  @@index([supplierId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([foremanId, createdAt])
  @@index([reference])
}

// Items inside the site order
model SiteProductOrderItem {
  id String @id @default(cuid())

  orderId String
  order   SiteProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  // quantity of the product (e.g. 5x 20L)
  quantity Int

  // ✅ IMPORTANT: snapshot the unit price used at order time (keeps history stable)
  unitPriceAtOrder Decimal @default(0) @db.Decimal(12, 2)

  // Optional: store what UOM/size was ordered (if product changes later)
  uomAtOrder      ProductUom?
  unitSizeAtOrder Decimal?    @db.Decimal(12, 3)

  note String?

  costCodeId String?
  costCode   SiteCostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([costCodeId])
}

//
// ============================
// FORTNIGHT MEETING REPORT (SNAPSHOT) - NEW
// ============================

model FortnightMeeting {
  id        String   @id @default(cuid())
  startDate DateTime // report range start
  endDate   DateTime // report range end
  meetingOn DateTime // your Thursday meeting date

  // Legacy – kept nullable for old data
  periodId String?

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  generatedAt       DateTime  @default(now())
  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedByUser   User?     @relation("FortnightMeetingFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows   FortnightMeetingRow[]
  totals FortnightMeetingTotals?

  period TimesheetPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@unique([startDate, endDate])
  @@index([meetingOn])
  @@index([finalizedAt])
}

model FortnightMeetingRow {
  id        String @id @default(cuid())
  meetingId String
  siteId    String

  // ===== COSTS (what you implement now) =====
  materialCost Decimal @default(0) @db.Decimal(14, 2)
  wagesCost    Decimal @default(0) @db.Decimal(14, 2)
  overtimeCost Decimal @default(0) @db.Decimal(14, 2)
  projectCost  Decimal @default(0) @db.Decimal(14, 2) // material + wages + overtime

  // ===== REVENUE (keep for later; set 0 now) =====
  revenueClaimed  Decimal @default(0) @db.Decimal(14, 2)
  revenueReceived Decimal @default(0) @db.Decimal(14, 2)

  // ===== PROFIT/LOSS (keep for later; set 0 now) =====
  profitOrLoss Decimal @default(0) @db.Decimal(14, 2)

  // Optional % columns (like your sheet). You can compute later.
  materialPct Decimal? @db.Decimal(8, 2)
  wagesPct    Decimal? @db.Decimal(8, 2)
  profitPct   Decimal? @db.Decimal(8, 2)

  // ===== COMPARISON VS PREVIOUS MEETING (optional snapshot) =====
  prevProjectCost  Decimal? @db.Decimal(14, 2)
  prevWagesCost    Decimal? @db.Decimal(14, 2)
  prevMaterialCost Decimal? @db.Decimal(14, 2)

  // deltas (current vs previous)
  projectCostDeltaPct  Decimal? @db.Decimal(8, 2)
  wagesCostDeltaPct    Decimal? @db.Decimal(8, 2)
  materialCostDeltaPct Decimal? @db.Decimal(8, 2)

  meeting FortnightMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  site    Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([meetingId, siteId])
  @@index([siteId])
}

//
// ============================
// OVERTIME PRICES + ENTRIES
// ============================

model OvertimePrice {
  id    String  @id @default(cuid())
  label String
  rate  Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overtimeEntries OvertimeEntry[]

  @@index([isActive])
}

model OvertimeEntry {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  foremanId String
  foreman   Foreman @relation(fields: [foremanId], references: [id], onDelete: Cascade)

  workDate DateTime

  overtimePriceId String
  overtimePrice   OvertimePrice @relation(fields: [overtimePriceId], references: [id], onDelete: Restrict)

  // Snapshot of the rate at creation time
  rateAtCreation Decimal @db.Decimal(12, 2)

  numberOfEmployees Int
  hoursWorked       Decimal @db.Decimal(6, 2)

  // Computed total = rateAtCreation * numberOfEmployees * hoursWorked
  totalCost Decimal @db.Decimal(14, 2)

  note String?

  costCodeId String?
  costCode   SiteCostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, workDate])
  @@index([foremanId, workDate])
  @@index([overtimePriceId])
  @@index([createdByUserId])
  @@index([workDate])
  @@index([costCodeId])
}

model FortnightMeetingTotals {
  id        String @id @default(cuid())
  meetingId String @unique

  totalMaterialCost Decimal @default(0) @db.Decimal(14, 2)
  totalWagesCost    Decimal @default(0) @db.Decimal(14, 2)
  totalOvertimeCost Decimal @default(0) @db.Decimal(14, 2)
  totalProjectCost  Decimal @default(0) @db.Decimal(14, 2)

  // Revenue totals (0 for now)
  totalRevenueClaimed  Decimal @default(0) @db.Decimal(14, 2)
  totalRevenueReceived Decimal @default(0) @db.Decimal(14, 2)

  // Profit/Loss total (0 for now)
  totalProfitOrLoss Decimal @default(0) @db.Decimal(14, 2)

  meeting FortnightMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// ============================
// MATERIALS (Clean seed model)
// ============================
// New material model for seeding clean product data independently of ProcurementProduct.
// No inventory tracking (materials are stocked at supplier, not internally).
// Sizes are managed per price point (e.g., 5L paint, 20L paint, 10KG cement)
// Suppliers use parent/child hierarchy: parent = brand (Plascon, Dulux), child = shop supplying us

model Material {
  id          String           @id @default(cuid())
  name        String           @unique
  sku         String?          @unique
  description String?
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Product classification
  productType  ProductType @default(MATERIAL)
  isReturnable Boolean     @default(false)

  // Color variants
  colors String[]

  isActive Boolean @default(true)

  // Deduction settings (PPE)
  isDeductible    Boolean @default(true)
  deductionSplits Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Preferred supplier (typically a brand like Plascon)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Prices by supplier with size variants
  prices MaterialPrice[]

  // Color variants for paints, etc.
  colorVariants MaterialColorVariant[]

  // References from site materials
  siteMaterials SiteMaterial[]

  @@index([isActive])
  @@index([categoryId])
  @@index([name])
  @@index([productType])
}

// Price per supplier per material, optionally per size/color
// Example: Plascon 5L paint at R437, Dulux 5L paint at R450, etc.
model MaterialPrice {
  id String @id @default(cuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // Optional: link to color variant
  colorVariantId String?
  colorVariant   MaterialColorVariant? @relation(fields: [colorVariantId], references: [id], onDelete: SetNull)

  // Size/unit of this price point (e.g. 5L, 20L, 10KG)
  // UOM is the unit type (L, KG, M, etc.)
  // unitSize is the quantity (5, 20, 10)
  uom      ProductUom?
  unitSize Decimal?    @db.Decimal(12, 3)

  // Current price for this supplier/size/color combo
  price Decimal @db.Decimal(12, 2)

  // Optional effective date range
  startsOn DateTime  @default(now())
  endsOn   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, materialId])
  @@index([materialId, isActive])
  @@index([supplierId, isActive])
}

model MaterialColorVariant {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  colorName String
  colorCode String?
  baseType  ColorBaseType @default(DEEP)
  isTinted  Boolean       @default(false)

  prices MaterialPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, colorName, baseType])
  @@index([materialId])
}

// ============================
// SITE MATERIALS (Bill of Materials)
// ============================
// Products expected to be used on a site (not actual orders)

model SiteMaterial {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Optional: reference to new clean Material model
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  // Optional estimated quantity
  quantity Int?

  // Optional note (e.g. "for main entrance walls")
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages SiteMaterialUsage[]

  finishingScheduleItems SiteFinishingScheduleItem[]

  @@unique([siteId, productId])
  @@index([siteId])
  @@index([productId])
  @@index([materialId])
}

// Usage tags for a site material — e.g. "External Walls", "Internal Walls", "Stills", "Main Color", "Feature Wall"
model SiteMaterialUsage {
  id String @id @default(cuid())

  siteMaterialId String
  siteMaterial   SiteMaterial @relation(fields: [siteMaterialId], references: [id], onDelete: Cascade)

  // e.g. "External Walls", "Internal Walls", "Stills", "Ceilings", "Feature Wall", "Main Color"
  label String

  // Optional quantity for this specific usage
  quantity Int?

  // Optional note
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteMaterialId])
}

// ============================
// FINISHING VARIANTS (kept for backward compat – unused by builder UI)
// ============================

model FinishingVariant {
  id              String  @id @default(cuid())
  label           String
  normalizedLabel String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleItems SiteFinishingScheduleItem[]

  @@index([isActive, sortOrder])
  @@index([normalizedLabel])
}

// ============================
// SITE FINISHING SCHEDULE
// ============================
// Defines the paint / finish specifications for each area of a site.
// Based on the Finishing Schedule document format:
//   Site -> Schedule (header) -> Areas -> Items (per position: product, color, supplier)

enum FinishingZone {
  INTERNAL
  EXTERNAL
}

model SiteFinishingSchedule {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Header info from the finishing schedule document
  siteAddress        String?
  contractNo         String?
  contractManager    String?
  siteForeman        String?
  fcpContractManager String?
  fcpQs              String?
  fcpSiteForeman     String?
  client             String?
  startDate          DateTime?
  completionDate     DateTime?
  drawingDetails     String?
  contactInfo        String?

  // Versioning / publishing
  version          Int       @default(1)
  isActive         Boolean   @default(true)
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByUser   User?     @relation("FinishingScheduleApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  supersededById   String?
  supersededBy     SiteFinishingSchedule?  @relation("FinishingScheduleVersionChain", fields: [supersededById], references: [id], onDelete: SetNull)
  previousVersions SiteFinishingSchedule[] @relation("FinishingScheduleVersionChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas SiteFinishingScheduleArea[]

  @@index([siteId])
  @@index([isActive])
  @@index([contractNo])
}

model SiteFinishingScheduleArea {
  id String @id @default(cuid())

  scheduleId String
  schedule   SiteFinishingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // e.g. "AA", "CA", "CB"
  name  String
  // e.g. "Internal/External", "Offices, Substation, warehouse"
  label String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SiteFinishingScheduleItem[]

  @@index([scheduleId])
}

model SiteFinishingScheduleItem {
  id String @id @default(cuid())

  areaId String
  area   SiteFinishingScheduleArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  zone FinishingZone

  // e.g. "Walls", "Bottom Band", "Doors", "Skirting", "Ceilings"
  position String @default("")

  // Legacy variant link (kept for backward compat – unused by builder UI)
  finishingVariantId   String?
  finishingVariant     FinishingVariant? @relation(fields: [finishingVariantId], references: [id], onDelete: SetNull)
  variantLabelSnapshot String?

  // Link directly to site material (primary product source)
  siteMaterialId String?
  siteMaterial   SiteMaterial? @relation(fields: [siteMaterialId], references: [id], onDelete: SetNull)

  // Snapshot/display values (auto-filled from site material)
  product   String?
  colorCode String?
  supplier  String?

  // Structured links for reporting / procurement
  procurementProductId String?
  procurementProduct   ProcurementProduct? @relation(fields: [procurementProductId], references: [id], onDelete: SetNull)

  supplierId  String?
  supplierRef Supplier? @relation("FinishingScheduleItemSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([zone])
  @@index([finishingVariantId])
  @@index([siteMaterialId])
  @@index([procurementProductId])
  @@index([supplierId])
}

// ============================
// EARLY SIGN-OUT REASONS
// ============================

model EarlySignOutReason {
  id              String  @id @default(cuid())
  label           String
  normalizedLabel String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
  requiresNote    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceScans AttendanceScan[]

  @@index([isActive, sortOrder])
  @@index([normalizedLabel])
}

// ============================
// SITE COST CODES
// ============================

model SiteCostCode {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteProductOrderItems SiteProductOrderItem[]
  overtimeEntries       OvertimeEntry[]

  @@unique([siteId, code])
  @@index([siteId])
  @@index([isActive])
}

// ============================
// SITE CLAIMS
// ============================

enum SiteClaimStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model SiteClaim {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  claimNo       String?
  claimDate     DateTime
  siteClaimDate DateTime?
  description   String?

  amountClaimed  Decimal @default(0) @db.Decimal(14, 2)
  amountReceived Decimal @default(0) @db.Decimal(14, 2)

  status SiteClaimStatus @default(DRAFT)

  createdByUserId String?
  createdByUser   User?   @relation("SiteClaimCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, claimDate])
  @@index([status])
  @@index([claimNo])
}

// ============================
// PAINT PLANNING & USAGE
// ============================

model ProcurementProductCoverage {
  id String @id @default(cuid())

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // optional size this coverage applies to, e.g. 20L
  uom      ProductUom?
  unitSize Decimal?    @db.Decimal(12, 3)

  // how many square metres this size covers
  coverageM2 Decimal @db.Decimal(12, 2)

  // optional note, e.g. "2 coats on smooth plaster"
  note String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paintPlans SitePaintPlan[]

  @@index([productId, isActive])
}

model SitePaintPlan {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  boqReference String?
  description  String

  areaM2 Decimal @db.Decimal(12, 2)

  productId String
  product   ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  coverageId String?
  coverage   ProcurementProductCoverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)

  coats Int @default(1)

  requiredLitres     Decimal @db.Decimal(12, 2)
  requiredContainers Decimal @db.Decimal(12, 2)
  roundedContainers  Int

  estimatedCost Decimal? @db.Decimal(14, 2)

  note String?

  createdByUserId String?
  createdByUser   User?   @relation("PaintPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages SitePaintUsage[]

  @@index([siteId, createdAt])
  @@index([productId])
}

model SitePaintUsage {
  id String @id @default(cuid())

  planId String
  plan   SitePaintPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  usedLitres     Decimal? @db.Decimal(12, 2)
  usedContainers Decimal? @db.Decimal(12, 2)

  note   String?
  usedOn DateTime @default(now())

  createdByUserId String?
  createdByUser   User?   @relation("PaintUsageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([planId, usedOn])
}

// ─── Notifications ────────────────────────────────────

enum NotificationType {
  PAINT_50_PERCENT
  PAINT_90_PERCENT
  SITE_CREATED
  SITE_FINISHED
  TIMESHEET_SUBMITTED
  TIMESHEET_APPROVED
  TIMESHEET_REJECTED
  PHOTO_REQUESTED
  PHOTO_REJECTED
  MATERIAL_ORDER
  GENERAL
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Optional link to a related entity
  siteId  String?
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  linkUrl String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([siteId])
}

// ============================
// SCHEDULER / TASK BOARD
// ============================

enum SchedulerTaskCategory {
  MEETING
  TODO
  REMINDER
  EVENT
}

enum SchedulerTaskPriority {
  LOW
  MEDIUM
  HIGH
}

model SchedulerTask {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    SchedulerTaskCategory @default(TODO)
  priority    SchedulerTaskPriority @default(MEDIUM)
  time        String?
  date        DateTime
  column      String                @default("todo") // "todo" | "in-progress" | "done"
  sortOrder   Int                   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, column])
  @@index([userId, date])
}

// ============================
// USER NOTES
// ============================

enum NoteColor {
  DEFAULT
  RED
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
}

enum NoteMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum NoteInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model UserNote {
  id String @id @default(cuid())

  // owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String    @default("")
  content  String    @default("")
  color    NoteColor @default(DEFAULT)
  isPinned Boolean   @default(false)

  // NEW
  isRoomNote Boolean @default(false)
  background String  @default("note-bg")

  attachments NoteAttachment[]
  comments    NoteComment[]    @relation("NoteComments")

  // NEW
  members NoteMember[]
  invites NoteInvite[]

  // NEW: Real-time collaboration
  presences     NotePresence[]
  editHistories NoteEditHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isPinned, updatedAt])
  @@index([isRoomNote, updatedAt])
}

model NoteMember {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role NoteMemberRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([noteId, userId])
  @@index([userId])
  @@index([noteId])
}

model NoteInvite {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedByUser   User   @relation("NoteInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  invitedUserId String
  invitedUser   User   @relation("NoteInviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)

  role   NoteMemberRole   @default(VIEWER)
  status NoteInviteStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  acceptedAt DateTime?
  declinedAt DateTime?

  @@unique([noteId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([noteId, status])
}

model NoteAttachment {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  url      String
  publicId String @default("")
  name     String
  type     String
  size     Int    @default(0)
  mimeType String @default("")

  createdAt DateTime @default(now())

  @@index([noteId])
}

model NoteComment {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation("NoteComments", fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserNoteComments", fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([userId])
}

model SiteProgressNote {
  id        String   @id @default(cuid())
  siteId    String
  content   String
  authorId  String?
  createdAt DateTime @default(now())

  site   Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author User? @relation("SiteProgressNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
}

// ============================
// PLANT ASSIGNMENTS
// ============================
// Tracks returnable plant/equipment deployed to a site (no purchase price needed).

model SitePlantAssignment {
  id        String      @id @default(cuid())
  reference String? // BuildSmart PO number or manual order reference (shared across all rows in one deployment)
  siteId    String
  productId String
  quantity  Int         @default(1)
  status    PlantStatus @default(DEPLOYED)

  deployedOn DateTime  @default(now())
  returnedOn DateTime?

  note           String?
  supervisorName String?

  // Optional cost charging
  unitPrice    Decimal? @db.Decimal(12, 2)
  chargeToSite Boolean  @default(false)

  assignedByUserId String?

  // Transfer provenance — set when this assignment was created via a transfer
  transferredFromSiteId       String?
  transferredFromAssignmentId String?

  site           Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product        ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  assignedByUser User?              @relation("PlantAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  // Size variant deployed (e.g. "3m", "5m")
  size String?

  // Transfer history
  transfersOut PlantTransfer[] @relation("PlantTransferFromAssignment")
  transfersIn  PlantTransfer[] @relation("PlantTransferToAssignment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([siteId])
  @@index([productId])
  @@index([status])
  @@index([assignedByUserId])
}

// ============================
// PLANT TRANSFERS
// ============================
// Full audit trail every time plant moves between sites or supervisors.

model PlantTransfer {
  id        String @id @default(cuid())
  productId String
  quantity  Int    @default(1)

  // Null = office/storage
  fromSiteId String?
  toSiteId   String?

  // Links to the affected assignments (source is reduced/closed; dest is created)
  fromAssignmentId String?
  toAssignmentId   String?

  note String?

  transferredByUserId String?

  transferredOn DateTime @default(now())
  createdAt     DateTime @default(now())

  product           ProcurementProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromSite          Site?                @relation("PlantTransferFromSite", fields: [fromSiteId], references: [id], onDelete: SetNull)
  toSite            Site?                @relation("PlantTransferToSite", fields: [toSiteId], references: [id], onDelete: SetNull)
  fromAssignment    SitePlantAssignment? @relation("PlantTransferFromAssignment", fields: [fromAssignmentId], references: [id], onDelete: SetNull)
  toAssignment      SitePlantAssignment? @relation("PlantTransferToAssignment", fields: [toAssignmentId], references: [id], onDelete: SetNull)
  transferredByUser User?                @relation("PlantTransferredByUser", fields: [transferredByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([fromAssignmentId])
  @@index([toAssignmentId])
  @@index([transferredOn])
}

// ============================
// FOREMAN PPE ORDERS
// ============================
// Foreman requests PPE items for workers on a site.

model ForemanPpeOrder {
  id        String         @id @default(cuid())
  foremanId String
  siteId    String?
  status    PpeOrderStatus @default(PENDING)
  note      String?

  // Whether this order's cost is charged against the site's material budget
  chargeToSite Boolean @default(false)

  createdByUserId String?

  foreman       Foreman @relation(fields: [foremanId], references: [id], onDelete: Cascade)
  site          Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdByUser User?   @relation("PpeOrderCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  items ForemanPpeOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foremanId])
  @@index([siteId])
  @@index([status])
}

model ForemanPpeOrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  quantity Int
  size     String? // "S", "M", "L", "XL", "Size 8", etc.
  color    String? // selected color if product has colors
  note     String?

  // Price snapshot at order time (for charge-to-site calculation)
  unitPriceAtOrder Decimal? @db.Decimal(12, 2)

  order   ForemanPpeOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ProcurementProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============================
// EQUIPMENT INVENTORY
// ============================
// Physical inventory tracking — who holds what equipment in the field.

model EquipmentHolder {
  id        String          @id @default(cuid())
  name      String          @unique
  items     EquipmentItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model EquipmentItem {
  id        String           @id @default(cuid())
  holderId  String?
  holder    EquipmentHolder? @relation(fields: [holderId], references: [id], onDelete: SetNull)
  category  String // e.g. "6ft Ladders", "Safety Belts"
  item      String // specific item name
  quantity  Int
  condition String // "Good" | "Beyond Repair" | "Needs Service" | "Stolen"
  notes     String?
  location  String? // "Office", "Cape Town", site name, etc.
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([holderId])
  @@index([category])
  @@index([condition])
}

// ============================
// CAPE TOWN STOCK
// ============================

model CapeTownStockItem {
  id        String        @id @default(cuid())
  name      String
  category  StockCategory
  // total quantity (sum of variants when variants exist, direct count otherwise)
  quantity  Int           @default(0)
  unit      String?
  notes     String?
  // available size options (e.g. ["S","M","L","XL"] or ["Small","Medium","Large"])
  sizes     String[]
  // available colour options (e.g. ["Yellow","Orange","White"])
  colors    String[]
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  variants    CapeTownStockVariant[]
  deployments CapeTownDeployment[]
  orders      CapeTownStockOrder[]

  @@index([category])
  @@index([isActive])
}

// Per size × color inventory for a Cape Town stock item
model CapeTownStockVariant {
  id     String            @id @default(cuid())
  itemId String
  item   CapeTownStockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  size   String?
  color  String?
  qty    Int               @default(0)

  @@unique([itemId, size, color])
  @@index([itemId])
}

model CapeTownDeployment {
  id         String            @id @default(cuid())
  itemId     String
  item       CapeTownStockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty        Int
  size       String?
  color      String?
  deployedTo String
  notes      String?
  deployedAt DateTime          @default(now())
  createdAt  DateTime          @default(now())

  @@index([itemId])
  @@index([deployedAt])
}

model CapeTownStockOrder {
  id        String              @id @default(cuid())
  itemId    String
  item      CapeTownStockItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty       Int
  size      String?
  color     String?
  supplier  String?
  status    CapeTownOrderStatus @default(PENDING)
  notes     String?
  orderedAt DateTime            @default(now())
  createdAt DateTime            @default(now())

  @@index([itemId])
  @@index([status])
}

enum CapeTownOrderStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

//
// ============================
// REAL-TIME COLLABORATION
// ============================

// Track active users currently editing/viewing a note
model NotePresence {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cursorPosition Int? // Character position in the note
  cursorLine     Int? // Line number (for structured content)
  isActive       Boolean @default(true)
  isTyping       Boolean @default(false)
  isEditing      Boolean @default(false)

  lastActivityAt DateTime @updatedAt // Auto-update on any activity
  connectedAt    DateTime @default(now())

  @@unique([noteId, userId])
  @@index([noteId, isActive])
  @@index([userId])
  @@index([lastActivityAt])
}

// Track recent edits with user attribution for undo/history
model NoteEditHistory {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  previousContent String // Content before this edit
  newContent      String // Content after this edit
  changeType      String @default("text") // "text", "title", "color", etc.
  operation       String @default("update") // "insert", "delete", "replace", "update"

  startPosition Int? // Start position of change
  endPosition   Int? // End position of change

  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
  @@index([userId])
}

// ============================
// SITE / JOB PROGRAMME PLANNER
// ============================

enum SiteProgrammeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SiteProgrammeItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERSTAYED
  CANCELLED
}

model SiteProgramme {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  title       String
  description String?

  plannedStartDate  DateTime
  plannedFinishDate DateTime

  status SiteProgrammeStatus @default(DRAFT)

  createdByUserId String?
  createdByUser   User?   @relation("SiteProgrammeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SiteProgrammeItem[]

  @@index([siteId])
  @@index([status])
  @@index([plannedStartDate])
  @@index([plannedFinishDate])
}

model SiteProgrammeItem {
  id String @id @default(cuid())

  programmeId String
  programme   SiteProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  title       String
  trade       String?
  description String?

  plannedStartDate  DateTime
  plannedFinishDate DateTime

  actualStartDate  DateTime?
  actualFinishDate DateTime?

  status SiteProgrammeItemStatus @default(PLANNED)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programmeId])
  @@index([plannedStartDate])
