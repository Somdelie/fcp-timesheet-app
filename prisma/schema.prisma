// ============================
// SITE FINISHING SCHEDULE
// ============================
// Defines the paint / finish specifications for each area of a site.
// Based on the Finishing Schedule document format:
//   Site -> Schedule (header) -> Areas -> Items (per position: product, color, supplier)

enum FinishingZone {
  INTERNAL
  EXTERNAL
}

model SiteFinishingSchedule {
  id String @id @default(cuid())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Header info from the finishing schedule document
  contractNo         String?
  contractManager    String?
  siteForeman        String?
  fcpContractManager String?
  fcpSiteForeman     String?
  client             String?
  startDate          DateTime?
  completionDate     DateTime?
  drawingDetails     String?
  contactInfo        String?

  // Versioning / publishing
  version          Int       @default(1)
  isActive         Boolean   @default(true)
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByUser   User?     @relation("FinishingScheduleApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  supersededById   String?
  supersededBy     SiteFinishingSchedule?  @relation("FinishingScheduleVersionChain", fields: [supersededById], references: [id], onDelete: SetNull)
  previousVersions SiteFinishingSchedule[] @relation("FinishingScheduleVersionChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas SiteFinishingScheduleArea[]

  @@index([siteId])
  @@index([isActive])
  @@index([contractNo])
}

model SiteFinishingScheduleArea {
  id String @id @default(cuid())

  scheduleId String
  schedule   SiteFinishingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // e.g. "AA", "CA", "CB"
  name  String
  // e.g. "Internal/External", "Offices, Substation, warehouse"
  label String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SiteFinishingScheduleItem[]

  @@index([scheduleId])
}

model SiteFinishingScheduleItem {
  id String @id @default(cuid())

  areaId String
  area   SiteFinishingScheduleArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  zone FinishingZone

  // e.g. "Walls", "Bottom Band", "Doors", "Skirting", "Ceilings"
  position String @default("")

  // Legacy variant link (kept for backward compat – unused by builder UI)
  finishingVariantId   String?
  finishingVariant     FinishingVariant? @relation(fields: [finishingVariantId], references: [id], onDelete: SetNull)
  variantLabelSnapshot String?

  // Link directly to site material (primary product source)
  siteMaterialId String?
  siteMaterial   SiteMaterial? @relation(fields: [siteMaterialId], references: [id], onDelete: SetNull)

  // Snapshot/display values (auto-filled from site material)
  product   String?
  colorCode String?
  supplier  String?

  // Structured links for reporting / procurement
  procurementProductId String?
  procurementProduct   ProcurementProduct? @relation(fields: [procurementProductId], references: [id], onDelete: SetNull)

  supplierId  String?
  supplierRef Supplier? @relation("FinishingScheduleItemSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([zone])
  @@index([finishingVariantId])
  @@index([siteMaterialId])
  @@index([procurementProductId])
  @@index([supplierId])
}

