}

model UserNote {
  id String @id @default(cuid())

  // owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String    @default("")
  content  String    @default("")
  color    NoteColor @default(DEFAULT)
  isPinned Boolean   @default(false)

  // NEW
  isRoomNote Boolean @default(false)
  background String  @default("note-bg")

  attachments NoteAttachment[]
  comments    NoteComment[]    @relation("NoteComments")

  // NEW
  members NoteMember[]
  invites NoteInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isPinned, updatedAt])
  @@index([isRoomNote, updatedAt])
}

model NoteMember {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role NoteMemberRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([noteId, userId])
  @@index([userId])
  @@index([noteId])
}

model NoteInvite {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedByUser   User   @relation("NoteInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  invitedUserId String
  invitedUser   User   @relation("NoteInviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)

  role   NoteMemberRole   @default(VIEWER)
  status NoteInviteStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  acceptedAt DateTime?
  declinedAt DateTime?

  @@unique([noteId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([noteId, status])
}

model NoteAttachment {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  url      String
  publicId String @default("")
  name     String
  type     String
  size     Int    @default(0)
  mimeType String @default("")

  createdAt DateTime @default(now())

  @@index([noteId])
}

model NoteComment {
  id String @id @default(cuid())

  noteId String
  note   UserNote @relation("NoteComments", fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserNoteComments", fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([userId])
}
